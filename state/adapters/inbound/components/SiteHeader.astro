---
import ProfileIcons from './ProfileIcons.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../../../../logic/site/site_config';
import {
  navigationAnchor,
  navigationLinks,
} from '../../../../logic/site/navigation';
import { siteHref, sitePath } from '../site_links';

interface Props {
  readonly path: string;
}

const { path } = Astro.props;

const links = navigationLinks(sitePath(path)).map((link) => ({
  label: link.label,
  external: link.external,
  href: link.external ? link.href : siteHref(link.href),
  attributes: navigationAnchor(link),
}));
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-4 px-6 py-6 md:flex-nowrap"
  >
    <a
      href={siteHref('/')}
      class="display text-xs tracking-[0.2em] sm:text-sm md:whitespace-nowrap"
      >{SITE.name}</a
    >
    <div class="ml-auto flex items-center gap-x-5 sm:gap-x-6">
      <nav aria-label="Main">
        <ul class="flex items-center gap-x-5 sm:gap-x-6">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="nav-link" {...link.attributes}>
                  {link.label}
                  {link.external && <span aria-hidden="true"> &#8599;</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ProfileIcons />
      <ThemeToggle />
    </div>
  </div>
</header>
