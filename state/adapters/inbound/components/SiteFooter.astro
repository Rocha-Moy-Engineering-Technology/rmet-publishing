---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../../../../logic/site/site_config';
import { siteHref } from '../site_links';

const year = new Date().getUTCFullYear();
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.author}</p>
    <SocialLinks />
    <a
      href={siteHref('/rss.xml')}
      class="underline decoration-line underline-offset-4 transition hover:text-accent"
      >Feed</a
    >
  </div>
</footer>
