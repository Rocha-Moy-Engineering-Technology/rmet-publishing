---
import { slugify } from '../../../../logic/text/slugify';
import { tagPath } from '../../../../logic/posts/post_routes';
import { siteHref } from '../site_links';

interface Props {
  readonly tags: readonly string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a href={siteHref(tagPath(slugify(tag)))} class="chip inline-block">
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
