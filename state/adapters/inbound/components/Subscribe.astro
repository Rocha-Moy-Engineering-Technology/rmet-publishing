---
import { resolveSubscribeSettings } from '../../../../logic/subscribe/subscribe_settings';
import { siteEnvironment } from '../../outbound/environment/site_environment';
import { SUBSCRIBE_POPOVER_ID } from '../subscribe_popover';

const settings = resolveSubscribeSettings(siteEnvironment().snapshot());
---

{
  settings && (
    <div
      id={SUBSCRIBE_POPOVER_ID}
      popover
      class="popover"
      aria-labelledby="subscribe-heading"
      data-testid="subscribe-popover"
    >
      <h2 id="subscribe-heading" class="display text-lg">
        New writing by email
      </h2>
      <p class="mt-3 text-sm text-muted">
        One email for each new piece as it is published, and nothing else.
        Unsubscribe with the link in any of them.
      </p>
      <form
        action={settings.action}
        method="post"
        target="_blank"
        class="mt-5 flex flex-col gap-4"
      >
        <label for="subscribe-email" class="label">
          Email address
        </label>
        <input
          id="subscribe-email"
          type="email"
          name={settings.emailField}
          required
          autofocus
          autocomplete="email"
          placeholder="you@example.com"
          class="field"
        />
        <div class="flex items-center justify-between gap-3">
          <button type="submit" class="chip cursor-pointer">
            Subscribe
          </button>
          <button
            type="button"
            class="nav-link cursor-pointer"
            popovertarget={SUBSCRIBE_POPOVER_ID}
            popovertargetaction="hide"
          >
            Close
          </button>
        </div>
      </form>
    </div>
  )
}
