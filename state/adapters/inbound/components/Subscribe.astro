---
import { resolveSubscribeSettings } from '../../../../logic/subscribe/subscribe_settings';
import { siteEnvironment } from '../../outbound/environment/site_environment';
import { siteHref } from '../site_links';

const settings = resolveSubscribeSettings(siteEnvironment().snapshot());
const feedHref = siteHref('/rss.xml');
const POPOVER_ID = 'subscribe-popover';
---

<section
  id="subscribe"
  data-testid="subscribe"
  aria-labelledby="subscribe-heading"
  class="mt-20 border-t border-line pt-10"
>
  <h2 id="subscribe-heading" class="display text-xl">New writing by email</h2>
  <p class="mt-3 text-sm text-muted">
    {
      settings
        ? 'One email for each new piece as it is published, and nothing else. Unsubscribe with the link in any of them.'
        : 'Email delivery is not switched on yet. The feed carries every new piece.'
    }
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    {
      settings && (
        <button
          type="button"
          class="chip cursor-pointer"
          popovertarget={POPOVER_ID}
          data-testid="subscribe-open"
        >
          Subscribe
        </button>
      )
    }
    <a
      href={feedHref}
      class="chip inline-flex items-center gap-2"
      data-testid="feed-link"
    >
      <svg
        viewBox="0 0 16 16"
        width="13"
        height="13"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M2 2.5A1.5 1.5 0 0 1 3.5 1C9.85 1 15 6.15 15 12.5a1.5 1.5 0 0 1-3 0A8.5 8.5 0 0 0 3.5 4 1.5 1.5 0 0 1 2 2.5Zm0 5A1.5 1.5 0 0 1 3.5 6a6.5 6.5 0 0 1 6.5 6.5 1.5 1.5 0 0 1-3 0A3.5 3.5 0 0 0 3.5 9 1.5 1.5 0 0 1 2 7.5ZM4 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"
        ></path>
      </svg>
      RSS feed
    </a>
  </div>
  {
    settings && (
      <div
        id={POPOVER_ID}
        popover
        class="popover"
        aria-labelledby="subscribe-popover-heading"
        data-testid="subscribe-popover"
      >
        <h3 id="subscribe-popover-heading" class="display text-lg">
          Subscribe by email
        </h3>
        <form
          action={settings.action}
          method="post"
          target="_blank"
          class="mt-5 flex flex-col gap-4"
        >
          <label for="subscribe-email" class="label">
            Email address
          </label>
          <input
            id="subscribe-email"
            type="email"
            name={settings.emailField}
            required
            autofocus
            autocomplete="email"
            placeholder="you@example.com"
            class="field"
          />
          <div class="flex items-center justify-between gap-3">
            <button type="submit" class="chip cursor-pointer">
              Subscribe
            </button>
            <button
              type="button"
              class="nav-link cursor-pointer"
              popovertarget={POPOVER_ID}
              popovertargetaction="hide"
            >
              Close
            </button>
          </div>
        </form>
      </div>
    )
  }
</section>
