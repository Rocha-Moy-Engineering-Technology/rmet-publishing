---
import { formatDate, toIsoDate } from '../../../../logic/text/format_date';
import { postPath } from '../../../../logic/posts/post_routes';
import { siteHref } from '../site_links';
import type { Post } from '../../../../types/post';

interface Props {
  readonly post: Post;
}

const { post } = Astro.props;
---

<article data-testid="post-card">
  <a href={siteHref(postPath(post))} class="entry">
    <div class="grid gap-x-10 gap-y-3 md:grid-cols-[9rem_1fr]">
      <p class="label pt-2">
        <time datetime={toIsoDate(post.publishedAt)}
          >{formatDate(post.publishedAt)}</time
        >
      </p>
      <div>
        <h2 class="entry-title">{post.title}</h2>
        <p class="mt-3 max-w-2xl text-muted">{post.description}</p>
        <p class="label mt-4">{post.readingMinutes} min read</p>
      </div>
    </div>
  </a>
</article>
