---
import KindBadge from './KindBadge.astro';
import { formatDate, toIsoDate } from '../../../../logic/text/format_date';
import { postPath } from '../../../../logic/posts/post_routes';
import { siteHref } from '../site_links';
import type { Post } from '../../../../types/post';

interface Props {
  readonly post: Post;
}

const { post } = Astro.props;
---

<article
  data-testid="post-card"
  class="group border-b border-line py-7 first:pt-0 last:border-b-0"
>
  <h2 class="text-xl font-semibold tracking-tight">
    <a
      href={siteHref(postPath(post))}
      class="transition group-hover:text-accent">{post.title}</a
    >
  </h2>
  <p class="mt-2 text-muted">{post.description}</p>
  <p
    class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted"
  >
    <KindBadge kind={post.kind} />
    <time datetime={toIsoDate(post.publishedAt)}
      >{formatDate(post.publishedAt)}</time
    >
    <span aria-hidden="true">·</span>
    <span>{post.readingMinutes} min read</span>
  </p>
</article>
