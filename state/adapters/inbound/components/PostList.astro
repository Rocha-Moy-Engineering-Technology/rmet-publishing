---
import PostCard from './PostCard.astro';
import type { Post } from '../../../../types/post';

interface Props {
  readonly posts: readonly Post[];
  readonly emptyMessage?: string;
}

const { posts, emptyMessage = 'No writings published yet' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="label border-t border-line py-10">{emptyMessage}</p>
  ) : (
    <div class="border-b border-line">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )
}
