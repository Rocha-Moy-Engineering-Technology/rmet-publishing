---
import { SITE } from '../../../../logic/site/site_config';
---

<ul class="flex flex-col gap-3">
  {
    SITE.profileLinks.map((link) => (
      <li>
        <a
          href={link.href}
          data-testid={link.testId}
          rel="me noopener"
          target="_blank"
          class="group flex flex-wrap items-baseline gap-x-4"
        >
          <span class="label w-24 group-hover:text-ink">{link.label}</span>
          <span class="text-muted transition group-hover:text-ink">
            {link.handle} <span aria-hidden="true">&#8599;</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
