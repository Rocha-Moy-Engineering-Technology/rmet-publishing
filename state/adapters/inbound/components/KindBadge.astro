---
import { kindLabel } from '../../../../logic/posts/post_kinds';
import type { PostKind } from '../../../../types/post';

interface Props {
  readonly kind: PostKind;
}

const { kind } = Astro.props;
---

<span
  data-testid="post-kind"
  class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-accent"
  >{kindLabel(kind).replace(' post', '')}</span
>
