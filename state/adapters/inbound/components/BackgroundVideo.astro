---
import { readBackgroundMedia } from '../../outbound/media/background_media_files';
import { siteHref } from '../site_links';

const media = readBackgroundMedia();
const poster = media.poster ? siteHref(media.poster) : undefined;
const hasVideo = media.sources.length > 0;
const hasStills = media.stills.length > 0;
const players = [0, 1];
---

{
  (hasVideo || hasStills) && (
    <>
      <div class="page-media" aria-hidden="true" data-testid="background-media">
        {hasStills && (
          <div class="page-media-stills">
            {media.stills.map((still) => (
              <img
                class="page-media-still"
                data-src={siteHref(still.src)}
                style={`object-position: ${still.focus}`}
                alt=""
                decoding="async"
              />
            ))}
          </div>
        )}
        {hasVideo &&
          players.map((index) => (
            <video
              class:list={['page-media-frame', index === 0 && 'is-active']}
              muted
              playsinline
              preload="none"
              poster={poster}
              tabindex="-1"
            >
              {media.sources.map((source) => (
                <source data-src={siteHref(source.src)} type={source.type} />
              ))}
            </video>
          ))}
      </div>
      <div class="page-media-scrim" aria-hidden="true" />
      {hasVideo && (
        <button
          type="button"
          class="chip sound-toggle"
          data-testid="sound-toggle"
          aria-pressed="false"
          aria-label="Turn the background sound on"
          hidden
        >
          <span data-sound-label>Sound off</span>
        </button>
      )}
    </>
  )
}

<script>
  import {
    BACKGROUND_HANDOVER_SECONDS,
    BACKGROUND_PLAYBACK_RATE,
    BACKGROUND_STILL_FADE_SECONDS,
    BACKGROUND_STILL_HOLD_SECONDS,
    BACKGROUND_WIDE_VIEWPORT,
    nextStillIndex,
    shouldHandOver,
  } from '../../../../logic/media/background_video';

  const players = Array.from(
    document.querySelectorAll<HTMLVideoElement>('.page-media-frame')
  );
  const stills = Array.from(
    document.querySelectorAll<HTMLImageElement>('.page-media-still')
  );
  const control = document.querySelector<HTMLButtonElement>(
    '[data-testid="sound-toggle"]'
  );
  const label = control?.querySelector<HTMLElement>('[data-sound-label]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const wide = matchMedia(BACKGROUND_WIDE_VIEWPORT);

  let active = 0;
  let muted = true;
  let videoStarted = false;
  let stillsStarted = false;

  const prepare = (player: HTMLVideoElement): void => {
    player.playbackRate = BACKGROUND_PLAYBACK_RATE;
    player.muted = muted;
  };

  const play = (player: HTMLVideoElement): void => {
    prepare(player);
    if (still.matches && muted) player.pause();
    else void player.play().catch(() => undefined);
  };

  /** Cross-fades to the standby player so the loop never seeks back to zero. */
  const handOver = (): void => {
    const outgoing = players[active];
    const next = (active + 1) % players.length;
    const incoming = players[next];
    incoming.currentTime = 0;
    play(incoming);
    incoming.classList.add('is-active');
    outgoing.classList.remove('is-active');
    active = next;
    window.setTimeout(() => {
      outgoing.pause();
      outgoing.currentTime = 0;
    }, BACKGROUND_HANDOVER_SECONDS * 1000);
  };

  const watch = (): void => {
    const current = players[active];
    if (
      current &&
      !current.paused &&
      shouldHandOver(current.currentTime, current.duration)
    ) {
      handOver();
    }
    requestAnimationFrame(watch);
  };

  const describe = (): void => {
    if (!control || !label) return;
    label.textContent = muted ? 'Sound off' : 'Sound on';
    control.setAttribute('aria-pressed', String(!muted));
    control.setAttribute(
      'aria-label',
      muted ? 'Turn the background sound on' : 'Turn the background sound off'
    );
  };

  /** Points a player at its sources and loads it, without playing it yet. */
  const attach = (player: HTMLVideoElement): void => {
    for (const source of Array.from(player.querySelectorAll('source'))) {
      const href = source.dataset.src;
      if (href) source.src = href;
    }
    player.load();
    prepare(player);
  };

  /** Attaches the video only on wide screens, so phones fetch none of it. */
  const startVideo = (): void => {
    if (videoStarted || players.length === 0) return;
    videoStarted = true;
    for (const player of players) attach(player);
    play(players[active]);
    players[active].addEventListener('loadedmetadata', () =>
      play(players[active])
    );
    requestAnimationFrame(watch);
  };

  /** Resolves once a still can paint whole; a failed image just goes ahead. */
  const ready = (image: HTMLImageElement): Promise<void> =>
    image.decode().catch(() => undefined);

  /** Dissolves the next still in over the current one once it has decoded. */
  const advance = (current: number): void => {
    const next = nextStillIndex(current, stills.length);
    void ready(stills[next]).then(() => {
      stills[current].classList.replace('is-active', 'is-leaving');
      show(next, current);
    });
  };

  /** Fades a still in, then holds it alone before the next one dissolves in. */
  const show = (index: number, previous?: number): void => {
    stills[index].classList.add('is-active');
    window.setTimeout(() => {
      if (previous !== undefined) {
        stills[previous].classList.remove('is-leaving');
      }
      if (stills.length > 1 && !still.matches) {
        window.setTimeout(
          () => advance(index),
          BACKGROUND_STILL_HOLD_SECONDS * 1000
        );
      }
    }, BACKGROUND_STILL_FADE_SECONDS * 1000);
  };

  /** Attaches the stills once and shows the first; narrow screens see these. */
  const startStills = (): void => {
    if (stillsStarted || stills.length === 0) return;
    stillsStarted = true;
    for (const image of stills) {
      image.style.transitionDuration = `${BACKGROUND_STILL_FADE_SECONDS}s`;
      const href = image.dataset.src;
      if (href) image.src = href;
    }
    void ready(stills[0]).then(() => show(0));
  };

  /** Sets the sound on both players, updates the control, and plays on. */
  const applySound = (value: boolean): void => {
    muted = value;
    for (const player of players) player.muted = muted;
    describe();
    play(players[active]);
  };

  control?.addEventListener('click', () => applySound(!muted));

  /**
   * The control belongs to the visible video: it shows only once the video
   * has started and while the screen is wide. A narrowing screen hides the
   * video, so it also turns the sound off rather than leave it playing unseen.
   */
  const syncControl = (): void => {
    if (!control || !videoStarted) return;
    control.hidden = !wide.matches;
    if (control.hidden && !muted) applySound(true);
  };

  /**
   * The stylesheet shows the video only on wide screens and the stills only
   * below them, so each starts, and is fetched, only where it can be seen.
   */
  const startForWidth = (): void => {
    if (wide.matches) startVideo();
    else startStills();
    syncControl();
  };

  startForWidth();
  wide.addEventListener('change', startForWidth);
  still.addEventListener('change', () => {
    if (videoStarted) play(players[active]);
  });
</script>
