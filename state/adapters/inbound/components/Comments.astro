---
import {
  giscusAttributes,
  resolveGiscusSettings,
} from '../../../../logic/comments/giscus_settings';
import { siteEnvironment } from '../../outbound/environment/site_environment';
import { siteHref } from '../site_links';

interface Props {
  readonly term: string;
}

const { term } = Astro.props;
const environment = siteEnvironment().snapshot();
const settings = resolveGiscusSettings(environment);
const attributes = settings ? giscusAttributes(settings, { term }) : undefined;
const discussionsUrl = settings
  ? `https://github.com/${settings.repo}/discussions`
  : undefined;
---

<section
  data-testid="comments"
  aria-labelledby="comments-heading"
  class="mt-16 border-t border-line pt-10"
>
  <h2 id="comments-heading" class="text-xl font-semibold tracking-tight">
    Comments and reactions
  </h2>
  {
    attributes ? (
      <>
        <p class="mt-2 text-sm text-muted">
          Comments and reactions run on GitHub Discussions. Sign in with GitHub
          to add yours.
        </p>
        <div class="mt-6">
          <script
            src="https://giscus.app/client.js"
            crossorigin="anonymous"
            async
            {...attributes}
          />
        </div>
        <p class="mt-4 text-sm text-muted">
          <a
            href={discussionsUrl}
            class="underline decoration-line underline-offset-4 hover:text-accent"
          >
            Open the discussion on GitHub
          </a>
        </p>
      </>
    ) : (
      <div class="mt-4 rounded-xl border border-line bg-raised p-5">
        <p class="text-muted">
          Comments and reactions are not connected yet. Set the four{' '}
          <code class="font-mono text-sm">PUBLIC_GISCUS_*</code> variables from{' '}
          <a
            href="https://giscus.app"
            class="underline decoration-line underline-offset-4 hover:text-accent"
          >
            giscus.app
          </a>{' '}
          to switch them on.
        </p>
        <p class="mt-3 text-muted">
          Until then, reach me through the{' '}
          <a
            href={siteHref('/contact')}
            class="underline decoration-line underline-offset-4 hover:text-accent"
          >
            contact page
          </a>
          .
        </p>
      </div>
    )
  }
</section>
