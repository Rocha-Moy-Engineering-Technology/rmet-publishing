---

---

<button
  type="button"
  data-testid="theme-toggle"
  aria-label="Switch between light and dark"
  class="icon-link flex h-5 w-5 items-center justify-center"
>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <circle
      cx="8"
      cy="8"
      r="6.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"></circle>
    <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  import { giscusThemeMessage } from '../../../../logic/comments/giscus_settings';
  import type { CommentsTheme } from '../../../../types/comments';

  (() => {
    const STORAGE_KEY = 'rmet-theme';
    const root = document.documentElement;

    const apply = (theme: CommentsTheme): void => {
      root.classList.toggle('light', theme === 'light');
      root.dataset.theme = theme;
      const frame = document.querySelector('iframe.giscus-frame');
      if (frame instanceof HTMLIFrameElement && frame.contentWindow) {
        frame.contentWindow.postMessage(
          giscusThemeMessage(theme === 'light' ? 'light' : 'dark'),
          'https://giscus.app'
        );
      }
    };

    const store = (theme: CommentsTheme): void => {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        /* storage unavailable; the choice lasts for this page only */
      }
    };

    for (const button of document.querySelectorAll(
      '[data-testid="theme-toggle"]'
    )) {
      button.addEventListener('click', () => {
        const next: CommentsTheme = root.classList.contains('light')
          ? 'dark'
          : 'light';
        apply(next);
        store(next);
      });
    }
  })();
</script>
