---

<ul class="flex items-center gap-4">
  {
    iconLinks().map((link) => (
      <li>
        <a
          href={link.href}
          data-testid={link.testId}
          rel="me noopener"
          target="_blank"
          aria-label={link.label}
          title={link.label}
          class="icon-link block"
        >
          <svg
            viewBox="0 0 16 16"
            width="17"
            height="17"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={MARKS[link.mark]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
