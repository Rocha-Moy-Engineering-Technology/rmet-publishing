---
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import Subscribe from '../../components/Subscribe.astro';
import TagChips from '../../components/TagChips.astro';
import { formatCitation } from '../../../../../logic/posts/citation';
import {
  WRITINGS_SEGMENT,
  absoluteUrl,
  postPath,
} from '../../../../../logic/posts/post_routes';
import { formatDate, toIsoDate } from '../../../../../logic/text/format_date';
import { SITE } from '../../../../../logic/site/site_config';
import {
  listPostDocuments,
  type PostEntry,
} from '../../../outbound/content/post_content_repository';
import { siteHref } from '../../site_links';
import type { Post } from '../../../../../types/post';

export const prerender = true;

export async function getStaticPaths() {
  const documents = await listPostDocuments();
  return documents.map(({ entry, post }) => ({
    params: { slug: post.slug },
    props: { entry, post },
  }));
}

interface Props {
  readonly entry: PostEntry;
  readonly post: Post;
}

const { entry, post } = Astro.props;
const { Content } = await render(entry);
const siteUrl = Astro.site?.href ?? SITE.defaultSiteUrl;
const canonical =
  post.canonicalUrl ?? absoluteUrl(siteUrl, siteHref(postPath(post)));
const citation = formatCitation(post, {
  siteName: SITE.publicationTitle,
  url: canonical,
  fallbackAuthor: SITE.author,
});
---

<BaseLayout
  title={post.title}
  description={post.description}
  canonicalUrl={canonical}
>
  <article class="mx-auto max-w-3xl">
    <p class="label">
      <time datetime={toIsoDate(post.publishedAt)}
        >{formatDate(post.publishedAt)}</time
      >
      <span aria-hidden="true"> / </span>
      <span>{post.readingMinutes} min read</span>
      {
        post.updatedAt && (
          <>
            <span aria-hidden="true"> / </span>
            <span>Updated {formatDate(post.updatedAt)}</span>
          </>
        )
      }
    </p>
    <h1 class="display mt-5 text-[clamp(2rem,5.5vw,3.5rem)]">{post.title}</h1>
    <p class="mt-5 max-w-2xl text-muted">{post.description}</p>
    {
      post.authors.length > 0 && (
        <p class="label mt-4">{post.authors.join(' / ')}</p>
      )
    }
    {
      post.pdfUrl && (
        <p class="mt-6">
          <a href={siteHref(post.pdfUrl)} class="chip inline-block">
            Portable Document Format (PDF)
          </a>
        </p>
      )
    }
    {
      post.abstract && (
        <section class="mt-10 border border-line p-6">
          <h2 class="label">Abstract</h2>
          <p class="mt-3 text-muted">{post.abstract}</p>
        </section>
      )
    }

    <div data-testid="post-body" class="prose mt-12 border-t border-line pt-12">
      <Content />
    </div>

    {
      post.tags.length > 0 && (
        <div class="mt-12">
          <TagChips tags={post.tags} />
        </div>
      )
    }

    {
      post.doi && (
        <section class="mt-12 border border-line p-6">
          <h2 class="label">Cite this</h2>
          <p class="mt-3 font-mono text-sm text-muted">{citation}</p>
        </section>
      )
    }

    <Subscribe />
    <Comments term={`${WRITINGS_SEGMENT}/${post.slug}`} />
  </article>
</BaseLayout>
