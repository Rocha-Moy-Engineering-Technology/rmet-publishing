---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import PostList from '../components/PostList.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../../../../logic/site/site_config';
import { postRepository } from '../../outbound/content/post_content_repository';

export const prerender = true;

const posts = await postRepository().listPosts();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <BackgroundVideo />

  <section class="max-w-4xl">
    <h1 class="display text-[clamp(2.25rem,6.5vw,4.5rem)]">
      {SITE.publicationTitle}
    </h1>
    <p class="mt-6 max-w-2xl text-muted">{SITE.tagline}</p>
  </section>

  <section class="mt-20">
    <h2 class="label mb-6">Writings</h2>
    <PostList posts={posts} />
  </section>

  <Subscribe />
</BaseLayout>
