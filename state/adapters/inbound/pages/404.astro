---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteHref } from '../site_links';

export const prerender = true;
---

<BaseLayout title="Not found" description="That address does not exist here.">
  <p class="label">Error 404</p>
  <h1 class="display mt-4 text-[clamp(2.5rem,7vw,4.5rem)]">Page not found</h1>
  <p class="mt-6 max-w-xl text-muted">
    The address may have changed, or the piece may never have existed.
  </p>
  <p class="mt-8">
    <a href={siteHref('/')} class="chip inline-block">Back to the writings</a>
  </p>
</BaseLayout>
