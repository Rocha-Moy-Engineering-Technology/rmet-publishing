---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags } from '../../../../../logic/posts/post_queries';
import { tagPath } from '../../../../../logic/posts/post_routes';
import { postRepository } from '../../../outbound/content/post_content_repository';
import { siteHref } from '../../site_links';

export const prerender = true;

const tags = collectTags(await postRepository().listPosts());
---

<BaseLayout title="Tags" description="Every subject covered here.">
  <header class="max-w-2xl">
    <h1 class="text-4xl font-semibold tracking-tight">Tags</h1>
    <p class="mt-4 text-lg text-muted">Every subject covered here.</p>
  </header>
  {
    tags.length === 0 ? (
      <p class="mt-10 text-muted">No tags yet.</p>
    ) : (
      <ul class="mt-10 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <li>
            <a
              href={siteHref(tagPath(tag.slug))}
              class="rounded-full border border-line px-4 py-2 text-muted transition hover:border-accent hover:text-accent"
            >
              {tag.tag} <span class="text-sm">({tag.count})</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
