---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import {
  collectTags,
  postsWithTag,
} from '../../../../../logic/posts/post_queries';
import { postRepository } from '../../../outbound/content/post_content_repository';
import type { Post } from '../../../../../types/post';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await postRepository().listPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.tag, posts: postsWithTag(posts, tag.slug) },
  }));
}

interface Props {
  readonly label: string;
  readonly posts: readonly Post[];
}

const { label, posts } = Astro.props;
---

<BaseLayout
  title={`Tagged ${label}`}
  description={`Everything published here about ${label}.`}
>
  <p class="label">Tag</p>
  <h1 class="display mt-4 text-[clamp(2rem,5vw,3.25rem)]">{label}</h1>
  <div class="mt-12">
    <PostList posts={posts} />
  </div>
</BaseLayout>
