---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import {
  POST_KINDS,
  kindDescription,
  kindPlural,
  kindSegment,
} from '../../../../../logic/posts/post_kinds';
import { postsOfKind } from '../../../../../logic/posts/post_queries';
import { postRepository } from '../../../outbound/content/post_content_repository';
import type { PostKind } from '../../../../../types/post';

export const prerender = true;

export function getStaticPaths() {
  return POST_KINDS.map((kind) => ({
    params: { kind: kindSegment(kind) },
    props: { kind },
  }));
}

interface Props {
  readonly kind: PostKind;
}

const { kind } = Astro.props;
const posts = postsOfKind(await postRepository().listPosts(), kind);
---

<BaseLayout title={kindPlural(kind)} description={kindDescription(kind)}>
  <header class="max-w-2xl">
    <h1 class="text-4xl font-semibold tracking-tight">{kindPlural(kind)}</h1>
    <p class="mt-4 text-lg text-muted">{kindDescription(kind)}</p>
  </header>
  <div class="mt-10">
    <PostList posts={posts} />
  </div>
</BaseLayout>
