{
  "name": "rmet-publishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "start": "serve -c serve.json -l tcp://0.0.0.0:${PORT:-4321} dist",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --project=smoke",
    "validate": "npm run format:check && npm run lint && npm run check && npm run test:coverage && npm run build",
    "test:generated": "npm run validate && npm run test:integration && npm run test:bdd && npm run test:e2e && npm run test:smoke"
  },
  "dependencies": {
    "astro": "~7.2.8",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "@types/node": "26.4.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "typescript-eslint": "8.68.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "playwright-bdd": "9.2.0",
    "get-port": "7.2.0"
  }
}
