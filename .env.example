# Public address the built site is served from. Used for canonical links,
# the feed, and the sitemap.
PUBLIC_SITE_URL=https://example.com

# Address shown on the contact page. Leave unset to fall back to the address
# in logic/site/site_config.ts.
PUBLIC_CONTACT_EMAIL=you@example.com

# Giscus (GitHub Discussions) comments and reactions.
# Generate these four values at https://giscus.app after enabling Discussions
# on the repository and installing the giscus GitHub App.
PUBLIC_GISCUS_REPO=owner/repository
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# Email subscriptions. Set the form-post address of a Really Simple Syndication
# (RSS) to email provider (Buttondown, Kit, Mailchimp, follow.it, ...) that
# watches /rss.xml; the site posts one email field to it. Must be an https://
# address, or the build fails. Buttondown's is
# https://buttondown.com/api/emails/embed-subscribe/<newsletter>
PUBLIC_SUBSCRIBE_ACTION=
# The field name the provider reads the address under; defaults to "email".
# Kit expects email_address, Mailchimp expects EMAIL.
PUBLIC_SUBSCRIBE_EMAIL_FIELD=
